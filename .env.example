# MetaTrader5 Configuration
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=MetaQuotes-Demo

# Trading Configuration
SYMBOL=XAUUSD
TIMEFRAME=1H
LOT_SIZE=0.1
INITIAL_BALANCE=10000
MULTI_TIMEFRAME_ENABLED=true
MULTI_TIMEFRAMES=M5,M15,H1
STRATEGY_TYPE=combined  # combined, ema_rsi, ai_only

# Risk Management
MAX_DAILY_LOSS=500
MAX_POSITION_SIZE=2
STOP_LOSS_PIPS=50
TAKE_PROFIT_PIPS=150
MAX_OPEN_TRADES=3
RISK_PERCENT_PER_TRADE=2.0
MIN_RISK_REWARD_RATIO=1.5

# AI Model Configuration
MODEL_TYPE=xgboost  # or sklearn
PREDICTION_CONFIDENCE_THRESHOLD=0.65
RETRAIN_FREQUENCY=7  # days

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_NOTIFICATIONS_ENABLED=true

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/trading_bot.log
MAX_LOG_SIZE=10MB
BACKUP_LOG_COUNT=5

# Backtesting
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_CAPITAL=10000
